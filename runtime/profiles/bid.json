[
  {"insert": [
    {"id":"sdk-app-startup","name":"@deepseek-ai/dsh-sdk-app","config":{"profile":"bid"}},
    {"id":"sdk-jsonrpc-server","name":"@deepseek-ai/dsh-sdk-jsonrpc-server","inject":["sdkAppStartup","loader"],"config":{"maxTokensAsSuccess":false}},
    {"id":"timer","name":"@deepseek-ai/cordis-plugin-timer"},
    {"id":"llm","name":"@deepseek-ai/dsh-llm"},
    {"id":"llm-deepseek","name":"@deepseek-ai/dsh-llm-deepseek-api-key","config":{
      "apiKeyEnv":"DEEPSEEK_API_KEY","thinking":"disabled","reasoningEffort":"off",
      "models":[{"id":"bid-fixture","contextWindow":32000,"maxTokens":2000,"inputModalities":["text"]}],
      "maxTokens":2000,"streamIdleTimeoutMs":10000,
      "retryPolicy":{"mode":"normal","maxRetries":2,"retryableCodes":["SERVER","RATE_LIMIT"],
        "backoff":{"initialDelayMs":10,"maxDelayMs":20,"jitterRatio":0}}
