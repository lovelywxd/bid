+++ b/packages/llm/llm-deepseek/src/bid-admission.ts
@@ -0,0 +1,30 @@
+/** Local bid deployment's send-time admission. No model routing or retries. */
+import { randomUUID } from 'node:crypto'
+import { LlmError } from '@deepseek-ai/dsh-llm'
+
+/** Acquire one single-use permit for the exact serialized text request.
+ * @param url - actual Messages URL.
+ * @param payload - serialized provider payload.
+ * @param signal - request cancellation.
+ * @returns request ledger identity.
+ */
+export async function bidAdmit(url: string, payload: string, signal: AbortSignal): Promise<string> {
+  const api = process.env.BID_API_URL
+  const token = process.env.BID_TASK_TOKEN
+  // This downstream build is intentionally unusable outside an admitted task.
+  if (!api || !token || !process.env.BID_MODEL_URL) throw new LlmError('Admission unavailable', 'INVALID_CONFIG')
+  if (url !== process.env.BID_MODEL_URL || new URL(url).hostname !== '127.0.0.1') {
+    throw new LlmError('Only the local fixture endpoint is enabled', 'INVALID_CONFIG')
+  }
+  const wire: Record<string, unknown> = JSON.parse(payload)
+  // Image/Files and unmeasured extra egress paths remain disabled in phase one.
+  if (/"type"\s*:\s*"(?:image|file)"/u.test(payload)) throw new LlmError('Text only', 'INVALID_CONFIG')
+  const id = randomUUID()
+  const response = await fetch(`${api}/internal/admit`, {
+    method: 'POST', signal, redirect: 'error',
+    headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },
+    body: JSON.stringify({ request_id: id, payload: wire, purpose: 'generation' }),
+  })
+  if (!response.ok) throw new LlmError(`Admission denied: ${await response.text()}`, 'INVALID_CONFIG')
+  return id
+}
